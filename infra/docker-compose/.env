# FleetIQ Development Environment Variables
# Used by Docker Compose for configurable values

# PostgreSQL
POSTGRES_USER=fleetiq
POSTGRES_PASSWORD=fleetiq_dev
POSTGRES_DB=fleetiq

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Vault
VAULT_DEV_ROOT_TOKEN_ID=fleetiq-dev-token

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=fleetiq-grafana

# Service Ports (host mapping)
TELEMETRY_HTTP_PORT=8081
TELEMETRY_GRPC_PORT=9001
DEVICE_HTTP_PORT=8082
DEVICE_GRPC_PORT=9002
TOPOLOGY_HTTP_PORT=8083
TOPOLOGY_GRPC_PORT=9003
MAINTENANCE_HTTP_PORT=8084
MAINTENANCE_GRPC_PORT=9004
STREAMING_HTTP_PORT=8085
STREAMING_GRPC_PORT=9005
